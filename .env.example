# Copy to .env.local for local development, and add the same keys in Vercel > Project > Settings > Environment Variables.
# GROQ_API_KEY is required for the assistant. The rest are optional: without them the contact form
# opens the visitor's email app, and the GitHub graph is hidden.

# Public URL of the deployed site, used for SEO metadata, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Ask About My Work, via Groq (required) (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional, defaults to openai/gpt-oss-20b
GROQ_MODEL=

# Contact form delivery via Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Inbox that receives messages
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Portfolio <hello@your-domain.com>". Defaults to Resend's onboarding sender.
CONTACT_FROM_EMAIL=

# GitHub contribution graph (classic token with no scopes, or fine-grained read-only public)
GITHUB_TOKEN=
